# FritzBox connection
# Use the base URL (http or https). The TR-064 port is added automatically
# if omitted (49000 for http, 49443 for https). You may also specify it
# explicitly, e.g. http://192.168.0.1:49000
FRITZBOX_URL=http://192.168.0.1
FRITZBOX_PASSWORD=your-password
# Optional: username (required on FRITZ!OS 7.25+; leave empty for older boxes)
FRITZBOX_USER=

# Web app login credentials (required)
APP_USER=admin
APP_PASSWORD=your-app-password

# Poll interval in seconds for mesh topology refresh
POLL_INTERVAL=10

# Server
PORT=3000
HOST=0.0.0.0
